<?xml version="1.0" encoding="UTF-8"?>
<xsd:schema xmlns="http://www.irs.gov/efile" xmlns:xsd="http://www.w3.org/2001/XMLSchema" targetNamespace="http://www.irs.gov/efile" elementFormDefault="qualified" attributeFormDefault="unqualified" version="1.0">
	<xsd:annotation>
		<xsd:documentation>
			<Description>Transmission Header for FSET, used wrap multiple returns together</Description>
			<TaxYear>2008</TaxYear>
			<Version>Draft Release</Version>
			<ReleaseDate>February 7, 2008</ReleaseDate>
		</xsd:documentation>
	</xsd:annotation>
	<xsd:include schemaLocation="..\ExtendedCommon\TransmissionHeader.xsd"/>
	<xsd:include schemaLocation="..\MotorFuelsSchema\MotorFuelsFiling.xsd"/>
	<xsd:element name="Transmission">
		<xsd:annotation>
			<xsd:documentation>Integrated Transmission schema for inclusion in SOAP body</xsd:documentation>
		</xsd:annotation>
		<xsd:complexType>
			<xsd:sequence>
				<xsd:element ref="TransmissionHeader"/>
				<xsd:element ref="MotorFuelsFiling" maxOccurs="unbounded"/>
			</xsd:sequence>
		</xsd:complexType>
	</xsd:element>
</xsd:schema>
